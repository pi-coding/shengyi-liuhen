.big-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 136rpx;
  border-radius: var(--radius, 24rpx);
  padding: 20rpx 40rpx;
  box-sizing: border-box;
  width: 100%;
}

.big-btn--primary {
  background-color: var(--color-primary, #8A4B2A);
  color: #FFFFFF;
}

.big-btn--accent {
  background-color: var(--color-accent, #4A7C59);
  color: #FFFFFF;
}

.big-btn--ghost {
  background-color: var(--color-surface, #FFFFFF);
  color: var(--color-primary-deep, #6F3C21);
  border: 2rpx solid var(--color-border, #ECE6DE);
}

.big-btn--hover {
  opacity: 0.9;
}

.is-disabled {
  opacity: 0.45;
}

.big-btn__text {
  font-size: 40rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.big-btn__sub {
  font-size: 26rpx;
  margin-top: 6rpx;
  opacity: 0.85;
}