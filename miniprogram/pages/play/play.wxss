.play__head {
  text-align: center;
  padding: 28rpx 16rpx 36rpx;
}

.play__title {
  font-size: 46rpx;
  font-weight: 700;
  color: var(--color-primary-deep);
  font-family: "Songti SC", "STSong", serif;
}

.play__status {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--color-text-tertiary);
}

.field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: var(--color-surface);
  border-radius: var(--radius-lg);
  padding: 22rpx 32rpx;
  box-shadow: var(--shadow-card);
}

.field__label {
  font-size: 32rpx;
  color: var(--color-text-secondary);
}

.field__value {
  font-size: 32rpx;
  color: var(--color-primary);
  padding: 10rpx 22rpx;
  background-color: var(--color-primary-soft);
  border-radius: var(--radius-sm);
}

.player {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  background-color: var(--color-surface);
  border-radius: var(--radius-lg);
  padding: 44rpx 32rpx;
  box-shadow: var(--shadow-card);
}

.player__btn {
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background-color: var(--color-primary);
  color: #FFFFFF;
  font-size: 40rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(138, 75, 42, 0.22);
}

.player__btn.is-playing {
  background-color: var(--color-accent);
  box-shadow: 0 8rpx 24rpx rgba(74, 124, 89, 0.24);
}

.player__hint {
  margin-top: 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-tertiary);
}

.script-card {
  margin-top: 20rpx;
}

.script-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
}

.script {
  margin-top: 14rpx;
  font-size: 32rpx;
  line-height: 1.9;
  color: var(--color-text-secondary);
  white-space: pre-wrap;
}