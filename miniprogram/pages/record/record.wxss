.record {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 40rpx;
}

.guide {
  width: 100%;
  text-align: center;
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-primary-deep);
  margin-bottom: 36rpx;
}

.edit-card {
  width: 100%;
  box-sizing: border-box;
  margin-bottom: 32rpx;
}

.edit-card__label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  margin-bottom: 16rpx;
}

.edit-card__area {
  width: 100%;
  min-height: 280rpx;
  font-size: 36rpx;
  line-height: 1.8;
  color: var(--color-text);
  background-color: #FAF8F5;
  border-radius: var(--radius-sm);
  padding: 24rpx;
  box-sizing: border-box;
}

.progress {
  width: 100%;
  margin-bottom: 32rpx;
}

.progress__bar {
  width: 100%;
  height: 6rpx;
  border-radius: 3rpx;
  background-color: var(--color-border);
  position: relative;
  overflow: hidden;
}

.progress__bar::after {
  content: "";
  position: absolute;
  top: 0;
  left: -40%;
  width: 40%;
  height: 100%;
  border-radius: 3rpx;
  background-color: var(--color-primary);
  animation: slide 1.1s ease-in-out infinite;
}

@keyframes slide {
  0% { left: -40%; }
  100% { left: 100%; }
}

.progress__text {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  color: var(--color-text-tertiary);
}

.recorder-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 24rpx;
}

.recorder {
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background-color: var(--color-primary);
  color: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(138, 75, 42, 0.22);
  transition: transform 0.12s ease, background-color 0.12s ease;
}

.recorder.is-recording {
  transform: scale(1.05);
  background-color: var(--color-accent);
  box-shadow: 0 8rpx 28rpx rgba(74, 124, 89, 0.28);
}

.recorder.is-disabled {
  opacity: 0.45;
}

.recorder__label {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.recorder__time {
  margin-top: 10rpx;
  font-size: 28rpx;
  opacity: 0.9;
}

.recorder__hint {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: var(--color-text-tertiary);
}

.actions {
  width: 100%;
  margin-top: 40rpx;
}

.actions__gap {
  height: 20rpx;
}