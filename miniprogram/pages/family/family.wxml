<view class="page-root safe-bottom family">
  <view class="list-head">家族记忆</view>

  <view wx:if="{{loading}}" class="empty-tip">正在加载…</view>
  <view wx:elif="{{stories.length === 0}}" class="empty-tip">还没有家族记忆，先让长辈讲一段吧</view>
  <view wx:else class="mems">
    <view wx:for="{{stories}}" wx:key="_id" class="mem">
      <view class="mem__row">
        <view class="mem__main" data-id="{{item._id}}" bindtap="openStory">
          <view class="mem__title">{{item.title}}</view>
          <view class="mem__date">{{item.dateText}}</view>
        </view>
        <view class="mem__link" data-id="{{item._id}}" bindtap="selectStory">
          {{currentId === item._id ? '收起留言' : '查看留言'}}
        </view>
      </view>

      <view wx:if="{{currentId === item._id}}" class="comments">
        <view wx:if="{{comments.length === 0}}" class="text-muted">还没有留言，写下第一句吧</view>
        <view wx:for="{{comments}}" wx:key="_id" wx:for-item="c" class="comment">
          <text class="comment__who">{{c.who || '家人'}}</text>
          <text class="comment__text">{{c.content}}</text>
        </view>
        <view class="comment-input">
          <input
            class="comment-input__field"
            value="{{input}}"
            placeholder="给这段回忆留句话"
            bindinput="onInput"
            confirm-type="send"
          />
          <view class="comment-input__btn" bindtap="onSubmitComment">发送</view>
        </view>
      </view>
    </view>
  </view>
</view>