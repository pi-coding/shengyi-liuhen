.family {
  padding-bottom: 60rpx;
}

.list-head {
  margin: 8rpx 0 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
}

.mems {
  background-color: var(--color-surface);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  overflow: hidden;
}

.mem {
  padding: 26rpx 32rpx;
  border-bottom: 2rpx solid var(--color-border);
}

.mem:last-child {
  border-bottom: none;
}

.mem__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.mem__main {
  flex: 1;
  min-width: 0;
}

.mem__title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mem__date {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

.mem__link {
  flex-shrink: 0;
  font-size: 26rpx;
  color: var(--color-accent);
  padding: 10rpx 20rpx;
  border-radius: var(--radius-sm);
  background-color: var(--color-accent-soft);
}

.comments {
  margin-top: 22rpx;
  border-top: 2rpx solid var(--color-border);
  padding-top: 18rpx;
}

.comment {
  display: flex;
  gap: 12rpx;
  margin-bottom: 14rpx;
  font-size: 30rpx;
  line-height: 1.6;
}

.comment__who {
  color: var(--color-primary);
  font-weight: 600;
  flex-shrink: 0;
}

.comment__text {
  color: var(--color-text);
  flex: 1;
}

.comment-input {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}

.comment-input__field {
  flex: 1;
  height: 76rpx;
  background-color: #FAF8F5;
  border-radius: var(--radius-sm);
  padding: 0 24rpx;
  font-size: 30rpx;
}

.comment-input__btn {
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 30rpx;
  background-color: var(--color-accent);
  color: #FFFFFF;
  border-radius: var(--radius-sm);
  font-size: 30rpx;
}